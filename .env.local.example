# Supabase — valeurs affichées par `supabase start` (local) ou dans le dashboard (cloud).
# La clé publique s'appelle désormais « publishable key » ; l'ancienne « anon key » fonctionne aussi.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key-from-supabase-start>

# URL publique du site (liens d'invitation, QR codes, Open Graph).
# Optionnelle : en local, http://localhost:3000 est pris par défaut ; sur Vercel, l'URL est
# déduite des variables système (VERCEL_PROJECT_PRODUCTION_URL / VERCEL_BRANCH_URL / VERCEL_URL).
# Ne la définir sur Vercel que pour forcer un domaine personnalisé.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mesure d'audience PostHog — optionnelle et désactivée par défaut.
# Sans NEXT_PUBLIC_POSTHOG_KEY : aucun script chargé, aucun cookie, pas de bandeau de consentement.
# L'hôte pointe par défaut sur la région européenne.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Places API (New) — import de restaurants depuis Google.
# Optionnelle : sans elle, l'onglet « Google » du sélecteur de restos n'apparaît pas.
# À créer dans Google Cloud (API « Places API (New) » activée), restreinte à cette API.
# Côté serveur uniquement : ne jamais la préfixer NEXT_PUBLIC_.
# GOOGLE_PLACES_API_KEY=<clé-google-cloud>

# Cloudflare Turnstile — captcha invisible sur le formulaire de pseudo.
# Optionnel et désactivé par défaut : sans ces DEUX variables, aucun script n'est chargé et
# la vérification serveur laisse passer. C'est l'interrupteur des tests e2e, de la CI et du
# développement local.
# À créer dans Cloudflare → Turnstile (widget « Invisible » ou « Managed »).
# La clé secrète reste côté serveur : ne jamais la préfixer NEXT_PUBLIC_.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site-key-cloudflare>
# TURNSTILE_SECRET_KEY=<secret-key-cloudflare>

# Notifications push (Web Push) — optionnelles et désactivées par défaut.
# Sans NEXT_PUBLIC_VAPID_PUBLIC_KEY, le bouton « Me prévenir » ne s'affiche pas ; sans les
# autres, /api/push/dispatch répond 204 sans rien envoyer.
# Paire VAPID : bunx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=<clé-publique-vapid>
# VAPID_PRIVATE_KEY=<clé-privée-vapid>
# VAPID_SUBJECT=mailto:contact@example.com
# Secret partagé avec la base : le même que le secret Vault `push_dispatch_secret`
# (voir README → Notifications push). Au moins 16 caractères, ex. `openssl rand -hex 32`.
# PUSH_DISPATCH_SECRET=<secret-partagé>
# Clé secrète Supabase (ex-service_role) : passe outre la RLS, lue par la seule route d'envoi.
# En local : la « Secret key » affichée par `supabase status`. Ne jamais la préfixer NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=<secret-key-from-supabase-status>
